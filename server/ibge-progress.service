[Unit]
Description=IBGE AC-TI study progress API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projetos/ibge-estudo/server
EnvironmentFile=/home/ubuntu/projetos/ibge-estudo/server/ibge-progress.env
ExecStart=/usr/bin/python3 /home/ubuntu/projetos/ibge-estudo/server/app.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
